# ==============================================================================
# UFONE FRANCHISE POS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development or set these variables in your
# cloud hosting provider (e.g. Render Dashboard -> Environment -> Environment Variables).
# DO NOT COMMIT PRIVATE PASSWORDS OR PRODUCTION SECRET KEYS TO GIT!
# ==============================================================================

# Application & Security
PROJECT_NAME="Ufone Franchise POS & Operations System"
VERSION="2.0.0"
ENVIRONMENT="production"

# Generate a strong 64-character secret key for JWT production tokens:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-your-secure-random-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default: sqlite:///./franchise_pos.db
# Cloud PostgreSQL on Render: postgresql://username:password@dpg-xxx.render.com/dbname
DATABASE_URL="sqlite:///./franchise_pos.db"

# Franchise Default Branding & Location
DEFAULT_FRANCHISE_NAME="Ufone Franchise - Dargai Office"
DEFAULT_BRANCH="Dargai Office"
DEFAULT_ADDRESS="Main Bazar, Dargai, Malakand, KP"
DEFAULT_PHONE="+92 333 9123456"
DEFAULT_CURRENCY="PKR"

# Initial Administration Password (Used only during fresh database seed)
ADMIN_INITIAL_PASSWORD="ChangeThisPasswordAfterFirstLogin123!"

# Frontend API Endpoint (Only needed if hosting frontend and backend on separate servers)
# VITE_API_BASE="https://your-backend-api.onrender.com/api/v1"
